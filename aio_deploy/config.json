  "prefix": "http://",
  "suffix": ":25808/#/guid",
  "main_app": true,
  "order": 0,
  "desc": "项目文件管理：支持文件搜索、@ 补全定位等功能\n预览与编辑：按项目保存标签，支持文本编辑、变更提醒和覆盖保护，优化文档下载与 Markdown 图片\n会话协作：支持会话分叉、@@ 引用其他会话，以及运行中发送消息\n执行交互：新增结构化问答卡、实时终端输出与单独停止\nTeam 模式：新增成员消息和任务看板，支持唤醒、切换模型及重启，修复状态与 MCP 问题\n会话管理：支持归档恢复、标为未读、消息搜索导航和计划清单展示\n内容展示：优化音频附件与语音输入，支持公式、Mermaid 缩放平移及 WaveDrom",
  "startup": true,
  "force_update": true,
  "device_limit": [
    {
      "key": "script_version",
      "operator": ">=",
      "value": "v1.8.4"
    },
    {
      "key": "any",
      "operator": "==",
      "value": [
        {
          "key": "device_model",
          "operator": "==",
          "value": "HLX-AIO-1P"
        },
        {
          "key": "device_model",
          "operator": "==",
          "value": "HLX-AIO-1B"
        }
      ]
    }
  ]
}
