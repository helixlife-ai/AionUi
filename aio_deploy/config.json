  "device_limit": [
    {
      "key": "script_version",
      "operator": ">=",
      "value": "v1.8.4"
    },
    {
      "key": "any",
      "operator": "==",
      "value": [
        {
          "key": "device_model",
          "operator": "==",
          "value": "HLX-AIO-1P"
        },
        {
          "key": "device_model",
          "operator": "==",
          "value": "HLX-AIO-1B"
        }
      ]
    }
  ]
}
